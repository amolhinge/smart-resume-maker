# Optional. Leave unset on Vercel — the app reads VERCEL_PROJECT_PRODUCTION_URL
# automatically, so canonical and Open Graph URLs always match the URL Vercel
# assigns to the project.
#
# Set this only when you connect a custom domain later, e.g.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# NEXT_PUBLIC_SITE_URL=
